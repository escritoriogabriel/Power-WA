# OpenWA server-side integration only. Never expose these values to the browser.
PORT=3000
POWER_WA_DATA_FILE=./data/power-wa.json
POWER_WA_OPERATOR_TOKEN=replace-with-a-long-random-operator-token
OPENWA_BASE_URL=https://openwa.example.invalid
OPENWA_API_KEY=owa_k1_example_only
OPENWA_WEBHOOK_SECRET=replace-with-a-long-random-secret
OPENWA_SESSION_ID=example-session-id
OPENWA_SESSION_NAME=power-wa
# Must be a publicly reachable HTTPS origin for OpenWA webhook delivery.
OPENWA_PUBLIC_URL=https://power-wa.example.invalid
